# Hugging Face access token. Keep this secret; never expose it in the frontend.
HF_TOKEN=hf_your_token_here
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# Optional shared key required by this service. Leave empty only during local development.
# In production, set this to a long random value and provide it to the frontend/backend.
APP_API_KEY=replace_with_a_long_random_value

# Retrieval settings
TOP_K=5
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# Storage configuration (optional, defaults to ./storage)
SHOPSPACE_STORAGE_DIR=./storage

# Knowledge base root directory (optional, defaults to project root)
SHOPSPACE_KNOWLEDGE_ROOT=../
